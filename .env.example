# Copy to .env at the repo root and fill in. This file is gitignored — never commit real values if testing locally
# Read by both scripts/dev.sh and the Vite client (via envDir in client/vite.config.ts)

# Base URL the client uses for API requests in local dev
VITE_API_URL=http://localhost:5244

# Name of the local SQL Server Docker container. Defaults to vinty-mssql if unset
DOCKER_NAME=vinty-mssql

# SA password for the local vinty-mssql Docker container (must match whatever
# password the container was created with — see MSSQL_SA_PASSWORD on the
# container itself if you're unsure: docker inspect vinty-mssql)
MSSQL_SA_PASSWORD=
